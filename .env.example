# Discord Bot Token
BOT_TOKEN=your-bot-token-here

# MongoDB
MONGO_URI=your-mongodb-uri
MONGO_DBNAME=capy-db
MONGO_USERNAME=mongo-user
MONGO_PASSWORD=securepassword

# MailJet Email API
MAILJET_API_KEY=your-mailjet-key
MAILJET_API_SECRET=your-mailjet-secret
MAILJET_API_EMAIL=your@email.com

# Ticket System Channel IDs (example IDs)
TICKET_BUG_REPORT_CHANNEL_ID=123456789012345678
TICKET_FEEDBACK_CHANNEL_ID=123456789012345679
TICKET_FEATURE_REQUEST_CHANNEL_ID=123456789012345680

# Debugging & Logging
WHO_DUNNIT=your-name
FAILED_COMMANDS_GUILD_ID=123456789012345681
FAILED_COMMANDS_CHANNEL_ID=123456789012345682
FAILED_COMMANDS_ROLE_ID=123456789012345683s

# Chatbot settings
ENABLE_CHATBOT=false
MODEL_NAME=deepseek-r1:14b

# Local Debug Guild (optional)
DEBUG_GUILD_ID=123456789012345684